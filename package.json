{
  "name": "mur-escalade-lardy",
  "private": true,
  "version": "1.4.0",
  "description": "Topo interactif du mur d'escalade de Lardy (ASSGA Escalade 2026-2027)",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p worker && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-pwa-assets": "pwa-assets-generator",
    "dev:worker": "vite build && wrangler d1 migrations apply mur-assga --local && wrangler dev"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@vite-pwa/assets-generator": "^2.0.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.156.0"
  }
}
